{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imajs-events-service",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imajs-events",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
